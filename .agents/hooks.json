{
  "permission-gate": {
    "PreToolUse": [
      {
        "matcher": "run_command|view_file|write_to_file|replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/permission-gate.js",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
